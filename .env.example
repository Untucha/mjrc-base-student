# Firebase Config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# 2Factor SMS API Key
VITE_2FACTOR_API_KEY=your_2factor_api_key

# WhatsApp Meta API
VITE_WHATSAPP_PHONE_ID=your_phone_id

# Admin Console Security Passcode
VITE_ADMIN_PASSCODE=admin123

# WhatsApp Baileys Socket Toggle (Set to 'false' for Vercel/serverless deployments)
ENABLE_WHATSAPP=false
